/// Calendário 2023-2025
table dCalendario
	lineageTag: 9ec340f2-fcc2-40a8-805d-c52fda5793cc
	dataCategory: Time

	column Date
		isUnique
		isNameInferred
		sourceColumn: [Date]

	column Ano
		isNameInferred
		sourceColumn: [Ano]

	column Mes_Num
		isNameInferred
		sourceColumn: [Mes_Num]

	column Mes
		isNameInferred
		sourceColumn: [Mes]

	column Ano_Mes
		isNameInferred
		sourceColumn: [Ano_Mes]

	column Mes_Ano
		isNameInferred
		sourceColumn: [Mes_Ano]

	column Trimestre
		isNameInferred
		sourceColumn: [Trimestre]

	column Periodo_Frete
		isNameInferred
		sourceColumn: [Periodo_Frete]

	partition dCalendario = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2023,1,1), DATE(2025,12,31)),
				    "Ano", YEAR([Date]),
				    "Mes_Num", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMM", "pt-BR"),
				    "Ano_Mes", FORMAT([Date], "YYYY-MM"),
				    "Mes_Ano", FORMAT([Date], "MMM/YY", "pt-BR"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "Periodo_Frete", IF([Date] >= DATE(2024,3,1), "Com frete grátis", "Antes do frete grátis")
				)

