/// Tabela de medidas
table _Medidas
	lineageTag: 0eaf65f4-9e67-4bdb-8ef3-7b0fe1372ba6

	/// Receita líquida de descontos dos itens entregues (exclui devolvidos e cancelados)
	measure 'Receita Líquida' = CALCULATE(SUM(fVendas[Receita_Liquida]), fVendas[Status] = "Entregue")
		formatString: "R$" #,0.00
		displayFolder: 1. Receita
		lineageTag: 2b161b6c-f8ca-49e8-9e28-d158785d8188

	/// Receita líquida vendida, antes de devoluções (exclui só cancelados)
	measure 'Receita Vendida' = CALCULATE(SUM(fVendas[Receita_Liquida]), fVendas[Status] <> "Cancelado")
		formatString: "R$" #,0.00
		displayFolder: 1. Receita
		lineageTag: 13589771-e117-4f58-85ea-19550a5e236a

	/// Pedidos distintos não cancelados
	measure Pedidos = CALCULATE(DISTINCTCOUNT(fVendas[ID_Pedido]), fVendas[Status] <> "Cancelado")
		formatString: #,0
		displayFolder: 1. Receita
		lineageTag: 080cab01-94e6-4748-8299-a982ad956e70

	/// Receita vendida por pedido
	measure 'Ticket Médio' = DIVIDE([Receita Vendida], [Pedidos])
		formatString: "R$" #,0.00
		displayFolder: 1. Receita
		lineageTag: c8d8522f-2010-4f50-b381-ae55411ad7ca

	/// Clientes distintos com pedido não cancelado
	measure 'Clientes Ativos' = CALCULATE(DISTINCTCOUNT(fVendas[ID_Cliente]), fVendas[Status] <> "Cancelado")
		formatString: #,0
		displayFolder: 1. Receita
		lineageTag: 2f412cd8-6ca0-41db-99fb-5f3700f4eead

	/// Receita líquida no mesmo período do ano anterior
	measure 'Receita Líquida AA' = CALCULATE([Receita Líquida], SAMEPERIODLASTYEAR(dCalendario[Date]))
		formatString: "R$" #,0.00
		displayFolder: 1. Receita
		lineageTag: a1af102d-fc01-4c89-b9c2-93420f01e6b3

	/// Variação da receita líquida vs ano anterior
	measure 'Receita Var % AA' = VAR _aa = [Receita Líquida AA] RETURN IF(_aa > 0, DIVIDE([Receita Líquida] - _aa, _aa))
		formatString: 0.0%
		displayFolder: 1. Receita
		lineageTag: 94e682f3-6be4-4597-be91-203f0cc9e4f4

	/// Custo da mercadoria dos itens entregues
	measure CMV = CALCULATE(SUM(fVendas[CMV]), fVendas[Status] = "Entregue")
		formatString: "R$" #,0.00
		displayFolder: 2. Custos
		lineageTag: bdad9cdc-2154-4def-ae71-ec6b5d3e51df

	/// Comissão de 16% paga ao marketplace sobre itens entregues
	measure 'Comissão Marketplace' = CALCULATE(SUM(fVendas[Comissao_Marketplace]), fVendas[Status] = "Entregue")
		formatString: "R$" #,0.00
		displayFolder: 2. Custos
		lineageTag: 378c62df-1054-4959-a302-ed2b0b478235

	/// Custo de frete pago pela LUMA e não cobrado do cliente (inclui devoluções)
	measure 'Frete Subsidiado' = CALCULATE(SUM(fVendas[Frete_Custo]) - SUM(fVendas[Frete_Cobrado]), fVendas[Status] <> "Cancelado")
		formatString: "R$" #,0.00
		displayFolder: 2. Custos
		lineageTag: 3e2ba0cc-e9ca-40d2-ad60-f637de7ba2f3

	/// Receita líquida - CMV - comissão marketplace - frete subsidiado
	measure 'Margem de Contribuição' = [Receita Líquida] - [CMV] - [Comissão Marketplace] - [Frete Subsidiado]
		formatString: "R$" #,0.00
		displayFolder: 3. Margem
		lineageTag: 32c9a768-9ba5-4d8f-be15-3e79d3ee2c13

	/// Margem de contribuição sobre a receita líquida
	measure 'Margem %' = DIVIDE([Margem de Contribuição], [Receita Líquida])
		formatString: 0.0%
		displayFolder: 3. Margem
		lineageTag: a3acd61d-d67b-48e9-a008-75a01feb0216

	/// Margem % no mesmo período do ano anterior
	measure 'Margem % AA' = CALCULATE([Margem %], SAMEPERIODLASTYEAR(dCalendario[Date]))
		formatString: 0.0%
		displayFolder: 3. Margem
		lineageTag: 5d88d28e-358f-47f3-a775-6bd91dc18d70

	/// Quanto sobra de margem a cada R$ 100 vendidos
	measure 'Lucro por R$100' = [Margem %] * 100
		formatString: "R$" #,0.00
		displayFolder: 3. Margem
		lineageTag: 173431d9-771a-4ebc-9548-adf170c6a66f

	/// Valor devolvido sobre a receita vendida
	measure 'Taxa de Devolução' = DIVIDE(CALCULATE(SUM(fVendas[Receita_Liquida]), fVendas[Status] = "Devolvido"), [Receita Vendida])
		formatString: 0.0%
		displayFolder: 4. Operação
		lineageTag: af571677-10a7-4e39-beff-01f16ef9fc71

	/// Participação de pedidos com frete grátis
	measure '% Pedidos Frete Grátis' = DIVIDE(CALCULATE([Pedidos], fVendas[Frete_Gratis] = "Sim"), [Pedidos])
		formatString: 0.0%
		displayFolder: 4. Operação
		lineageTag: 9605d2f6-859c-41c1-90d7-87019f8f70ce

	/// Prazo médio de entrega em dias
	measure 'Prazo Médio Entrega' = CALCULATE(AVERAGE(fVendas[Prazo_Entrega_Dias]), fVendas[Status] <> "Cancelado")
		formatString: 0.0
		displayFolder: 4. Operação
		lineageTag: c39444f1-66f3-49ab-aeec-50ce2ac320b1

	/// Data URI do WebP animado de fundo da capa, remontado das partes da tabela dMidia (o HTML Content bloqueia URLs externas).
	measure '_URL Fundo Capa' =
			VAR _m = FILTER(ALL(dMidia), dMidia[Midia] = "capa")
			VAR _tipo = MAXX(_m, dMidia[Tipo])
			RETURN
			    IF(
			        NOT ISEMPTY(_m),
			        "data:" & _tipo & ";base64," & CONCATENATEX(_m, dMidia[Parte], "", dMidia[Ordem], ASC)
			    )
		displayFolder: 9. HTML
		lineageTag: 434ecfa7-e031-4d7c-a7bb-d6a10414ec38

	/// Margem que teria entrado se cada ano mantivesse a margem % do primeiro ano selecionado
	measure 'Margem Perdida' =
			VAR _anoIni = CALCULATE(MIN(dCalendario[Ano]), ALLSELECTED(dCalendario))
			VAR _mIni = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoIni)
			RETURN
			    SUMX(
			        VALUES(dCalendario[Ano]),
			        CALCULATE([Receita Líquida] * _mIni - [Margem de Contribuição])
			    )
		formatString: "R$" #,0.00
		displayFolder: 3. Margem
		lineageTag: 98eedcdd-bc1c-4330-ab1c-b020e9b6598a

	/// Capa do relatório: imagem animada (WebP/GIF) de fundo + manchete + 3 KPIs dinâmicos. Usar no visual HTML Content (não aceita <video> nem JS).
	measure 'HTML Capa' =
			VAR _anoIni = CALCULATE(MIN(dCalendario[Ano]), ALLSELECTED(dCalendario))
			VAR _anoFim = CALCULATE(MAX(dCalendario[Ano]), ALLSELECTED(dCalendario))
			VAR _recIni = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoIni)
			VAR _recFim = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _mIni = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoIni)
			VAR _mFim = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _cresc = DIVIDE(_recFim - _recIni, _recIni)
			VAR _perdida = [Margem Perdida]
			VAR _url = [_URL Fundo Capa]
			
			VAR _fMi = FORMAT(_recFim / 1000000, "#,##0.00", "pt-BR")
			VAR _fCresc = FORMAT(_cresc * 100, "+#,##0;-#,##0", "pt-BR")
			VAR _fMFim = FORMAT(_mFim * 100, "#,##0.0", "pt-BR")
			VAR _fMIni = FORMAT(_mIni * 100, "#,##0.0", "pt-BR")
			VAR _fPerd = FORMAT(_perdida / 1000000, "#,##0.00", "pt-BR")
			VAR _fR100Ini = FORMAT(_mIni * 100, "#,##0", "pt-BR")
			VAR _fR100Fim = FORMAT(_mFim * 100, "#,##0", "pt-BR")
			
			VAR _css = "<style>
			*{box-sizing:border-box;margin:0;padding:0}
			.cv{position:relative;width:100%;height:100vh;min-height:520px;overflow:hidden;font-family:'Segoe UI',system-ui,sans-serif;color:#f4f1ec;background:radial-gradient(120% 90% at 50% 0%,#3b2a1f 0%,#1a1411 55%,#0d0a08 100%)}
			.cv .bg{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;opacity:.6}
			.ov{position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(13,10,8,.30) 0%,rgba(13,10,8,.50) 50%,rgba(13,10,8,.94) 100%)}
			.brand{position:absolute;top:6%;left:5%}
			.brand b{font-size:20px;letter-spacing:.32em;font-weight:700}
			.brand span{display:block;font-size:9px;letter-spacing:.3em;opacity:.6;margin-top:5px}
			.hero{position:absolute;top:22%;left:0;right:0;text-align:center;padding:0 6%}
			.eyebrow{font-size:11px;letter-spacing:.38em;text-transform:uppercase;opacity:.65}
			.cv h1{font-size:clamp(34px,6vw,66px);font-weight:700;margin:16px 0 12px;letter-spacing:-.01em}
			.sub{font-size:clamp(14px,1.6vw,19px);opacity:.88;font-weight:300}
			.sub b{color:#f0b48a;font-weight:600}
			.rule{width:260px;height:1px;background:rgba(244,241,236,.25);margin:24px auto 14px}
			.meta{font-size:10px;letter-spacing:.3em;opacity:.55;text-transform:uppercase}
			.kpis{position:absolute;bottom:17%;left:9%;right:9%;display:flex;border-top:1px solid rgba(244,241,236,.14);padding-top:26px}
			.k{flex:1;text-align:center;border-left:1px solid rgba(244,241,236,.14)}
			.k:first-child{border-left:0}
			.k .v{font-size:clamp(24px,3.2vw,40px);font-weight:700}
			.k .l{font-size:10px;letter-spacing:.25em;text-transform:uppercase;opacity:.72;margin-top:6px;font-weight:600}
			.k .n{font-size:12px;opacity:.55;margin-top:6px}
			.k.neg .v,.k.neg .l{color:#f08a6c}
			@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
			.a1,.a2,.a3,.a4,.a5{animation:up 1s ease both}
			.a2{animation-delay:.25s}.a3{animation-delay:.5s}.a4{animation-delay:.8s}.a5{animation-delay:1.1s}
			</style>"
			
			VAR _fundo = IF(_url <> "", "<img class='bg' src='" & _url & "' alt=''>", "")
			
			VAR _body =
			    "<div class='cv'>" & _fundo & "<div class='ov'></div>"
			    & "<div class='brand a1'><b>LUMA</b><span>CASA &amp; DECORAÇÃO</span></div>"
			    & "<div class='hero'>"
			    & "<div class='eyebrow a1'>Diagnóstico de rentabilidade &nbsp;·&nbsp; E-commerce</div>"
			    & "<h1 class='a2'>O custo do frete grátis</h1>"
			    & "<div class='sub a3'>De cada R$ 100 vendidos, a margem caiu de <b>R$ " & _fR100Ini & "</b> para <b>R$ " & _fR100Fim & "</b>.</div>"
			    & "<div class='rule a3'></div>"
			    & "<div class='meta a3'>Base " & _anoIni & "–" & _anoFim & " &nbsp;·&nbsp; Frete grátis desde mar/2024</div>"
			    & "</div>"
			    & "<div class='kpis'>"
			    & "<div class='k a4'><div class='v'>R$ " & _fMi & " Mi</div><div class='l'>Receita " & _anoFim & "</div><div class='n'>" & _fCresc & "% vs " & _anoIni & "</div></div>"
			    & "<div class='k a4'><div class='v'>" & _fMFim & "%</div><div class='l'>Margem " & _anoFim & "</div><div class='n'>era " & _fMIni & "% em " & _anoIni & "</div></div>"
			    & "<div class='k neg a5'><div class='v'>R$ " & _fPerd & " Mi</div><div class='l'>Margem que não entrou</div><div class='n'>vs margem de " & _anoIni & "</div></div>"
			    & "</div></div>"
			
			RETURN _css & _body
		displayFolder: 9. HTML
		lineageTag: a94a0259-0de6-43fe-9b0d-e280de6a4574

	/// Página 2 · Diagnóstico no idioma visual da capa: faixa com foto, KPIs em vidro, gráfico mensal (SVG só formas + textos/tooltip em HTML), mosaicos de R$ 100, canais e ações. Fonte: scripts/dax/HTML_Diagnostico.dax
	measure 'HTML Diagnostico' =
			/* Página 2 · Diagnóstico — mesmo idioma visual da capa (escuro quente, foto, vidro).
			   Regras do visual HTML Content: sem JS, sem URL externa. Textos do gráfico ficam
			   em HTML posicionado em % (o SVG estica só as formas, nunca as letras). */
			VAR _anoIni = CALCULATE(MIN(dCalendario[Ano]), ALLSELECTED(dCalendario))
			VAR _anoFim = CALCULATE(MAX(dCalendario[Ano]), ALLSELECTED(dCalendario))
			VAR _anoAnt = _anoFim - 1
			VAR _hero = [_Img Hero Diag]
			
			/* ---------- KPIs: último ano selecionado vs ano anterior ---------- */
			VAR _rec1 = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _rec0 = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
			VAR _mg1 = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _mg0 = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
			VAR _fr1 = CALCULATE([Frete Subsidiado], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _fr0 = CALCULATE([Frete Subsidiado], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
			VAR _dv1 = CALCULATE([Taxa de Devolução], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _dv0 = CALCULATE([Taxa de Devolução], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
			VAR _temAnt = NOT ISBLANK(_rec0)
			
			VAR _dRec = DIVIDE(_rec1 - _rec0, _rec0)
			VAR _dMg = (_mg1 - _mg0) * 100
			VAR _dFr = DIVIDE(_fr1 - _fr0, _fr0)
			VAR _dDv = (_dv1 - _dv0) * 100
			VAR _semBase = "<span class='nt'>sem ano anterior</span>"
			VAR _bRec = IF(_temAnt, "<span class='" & IF(_dRec >= 0, "up", "dn") & "'>" & IF(_dRec >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dRec) * 100, "0.0", "pt-BR") & "% vs " & _anoAnt & "</span>", _semBase)
			VAR _bMg = IF(_temAnt, "<span class='" & IF(_dMg >= 0, "up", "dn") & "'>" & IF(_dMg >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dMg), "0.0", "pt-BR") & " p.p. vs " & _anoAnt & "</span>", _semBase)
			VAR _bFr = IF(_temAnt, "<span class='" & IF(_dFr <= 0, "up", "dn") & "'>" & IF(_dFr >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dFr) * 100, "0.0", "pt-BR") & "% vs " & _anoAnt & "</span>", _semBase)
			VAR _bDv = IF(_temAnt, "<span class='" & IF(_dDv <= 0, "up", "dn") & "'>" & IF(_dDv >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dDv), "0.0", "pt-BR") & " p.p. vs " & _anoAnt & "</span>", _semBase)
			
			/* ---------- Composição de cada R$ 100 por ano ---------- */
			VAR _p100 =
			    ADDCOLUMNS(
			        CALCULATETABLE(VALUES(dCalendario[Ano]), ALLSELECTED(dCalendario)),
			        "@pc", DIVIDE([CMV], [Receita Líquida]) * 100,
			        "@pm", DIVIDE([Comissão Marketplace], [Receita Líquida]) * 100,
			        "@pf", DIVIDE([Frete Subsidiado], [Receita Líquida]) * 100,
			        "@pg", [Margem %] * 100
			    )
			VAR _cvI = MAXX(FILTER(_p100, dCalendario[Ano] = _anoIni), [@pc])
			VAR _cmI = MAXX(FILTER(_p100, dCalendario[Ano] = _anoIni), [@pm])
			VAR _frI = MAXX(FILTER(_p100, dCalendario[Ano] = _anoIni), [@pf])
			VAR _mgI = MAXX(FILTER(_p100, dCalendario[Ano] = _anoIni), [@pg])
			VAR _cvF = MAXX(FILTER(_p100, dCalendario[Ano] = _anoFim), [@pc])
			VAR _cmF = MAXX(FILTER(_p100, dCalendario[Ano] = _anoFim), [@pm])
			VAR _frF = MAXX(FILTER(_p100, dCalendario[Ano] = _anoFim), [@pf])
			VAR _mgF = MAXX(FILTER(_p100, dCalendario[Ano] = _anoFim), [@pg])
			
			/* mosaico 10x10: margem, frete, comissão, CMV (nessa ordem) */
			VAR _qmI = ROUND(_mgI, 0)
			VAR _qfI = ROUND(_frI, 0)
			VAR _qcI = ROUND(_cmI, 0)
			VAR _qmF = ROUND(_mgF, 0)
			VAR _qfF = ROUND(_frF, 0)
			VAR _qcF = ROUND(_cmF, 0)
			VAR _wafI =
			    CONCATENATEX(
			        GENERATESERIES(1, 100, 1),
			        "<i class='q" & IF([Value] <= _qmI, "m", IF([Value] <= _qmI + _qfI, "f", IF([Value] <= _qmI + _qfI + _qcI, "c", "v"))) & "'></i>",
			        "", [Value], ASC
			    )
			VAR _wafF =
			    CONCATENATEX(
			        GENERATESERIES(1, 100, 1),
			        "<i class='q" & IF([Value] <= _qmF, "m", IF([Value] <= _qmF + _qfF, "f", IF([Value] <= _qmF + _qfF + _qcF, "c", "v"))) & "'></i>",
			        "", [Value], ASC
			    )
			VAR _f1 = "0.0"
			VAR _linhaLeg =
			    "<div class='lr'><i class='qm'></i><span>Margem</span><b>R$ " & FORMAT(_mgI, _f1, "pt-BR") & " → R$ " & FORMAT(_mgF, _f1, "pt-BR") & "</b><em class='dn'>" & FORMAT(_mgF - _mgI, "+0.0;-0.0", "pt-BR") & "</em></div>"
			    & "<div class='lr'><i class='qf'></i><span>Frete subsidiado</span><b>R$ " & FORMAT(_frI, _f1, "pt-BR") & " → R$ " & FORMAT(_frF, _f1, "pt-BR") & "</b><em class='dn'>" & FORMAT(_frF - _frI, "+0.0;-0.0", "pt-BR") & "</em></div>"
			    & "<div class='lr'><i class='qc'></i><span>Comissão marketplace</span><b>R$ " & FORMAT(_cmI, _f1, "pt-BR") & " → R$ " & FORMAT(_cmF, _f1, "pt-BR") & "</b><em class='dn'>" & FORMAT(_cmF - _cmI, "+0.0;-0.0", "pt-BR") & "</em></div>"
			    & "<div class='lr'><i class='qv'></i><span>CMV</span><b>R$ " & FORMAT(_cvI, _f1, "pt-BR") & " → R$ " & FORMAT(_cvF, _f1, "pt-BR") & "</b><em class='nt'>" & FORMAT(_cvF - _cvI, "+0.0;-0.0", "pt-BR") & "</em></div>"
			
			/* ---------- Canais no último ano ---------- */
			VAR _canais =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(fVendas[Canal]), "@r", [Receita Líquida], "@m", [Margem %], "@d", [Taxa de Devolução]),
			        REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim
			    )
			VAR _rTot = SUMX(_canais, [@r])
			VAR _pior = TOPN(1, _canais, [@m], ASC)
			VAR _piorNome = MAXX(_pior, fVendas[Canal])
			VAR _piorM = MAXX(_pior, [@m])
			VAR _outrosM = DIVIDE(SUMX(FILTER(_canais, fVendas[Canal] <> _piorNome), [@r] * [@m]), SUMX(FILTER(_canais, fVendas[Canal] <> _piorNome), [@r]))
			VAR _canaisHtml =
			    CONCATENATEX(
			        _canais,
			        VAR _sh = DIVIDE([@r], _rTot) * 100
			        VAR _alerta = fVendas[Canal] = _piorNome
			        RETURN
			            "<div class='cc" & IF(_alerta, " al", "") & "'>"
			            & "<div class='cn'><b>" & fVendas[Canal] & "</b>" & IF(_alerta, "<span class='tag'>ATENÇÃO</span>", "") & "</div>"
			            & "<div class='cs'>" & FORMAT(_sh, "0", "pt-BR") & "% da receita</div>"
			            & "<div class='cbar'><i style='width:" & FORMAT(_sh, "0.0", "en-US") & "%'></i></div>"
			            & "<div class='cv'><div><b>" & FORMAT([@m] * 100, "0.0", "pt-BR") & "%</b><span>margem</span></div>"
			            & "<div><b>" & FORMAT([@d] * 100, "0.0", "pt-BR") & "%</b><span>devolução</span></div></div></div>",
			        "",
			        [@r], DESC
			    )
			
			/* ---------- Categoria que mais pesa no frete subsidiado ---------- */
			VAR _cats =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(dProduto[Categoria]), "@f", [Frete Subsidiado]),
			        REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim
			    )
			VAR _topCat = TOPN(1, _cats, [@f], DESC)
			VAR _topCatNome = MAXX(_topCat, dProduto[Categoria])
			VAR _topCatPct = DIVIDE(MAXX(_topCat, [@f]), SUMX(_cats, [@f]))
			
			/* ---------- Gráfico mensal ----------
			   SVG em viewBox 1000x1000 esticável (só formas). Textos e tooltip em HTML com posições em %. */
			VAR _base =
			    FILTER(
			        ADDCOLUMNS(
			            SUMMARIZE(dCalendario, dCalendario[Ano], dCalendario[Mes_Num], dCalendario[Mes_Ano]),
			            "@k", dCalendario[Ano] * 12 + dCalendario[Mes_Num],
			            "@r", [Receita Líquida],
			            "@m", [Margem %],
			            "@f", [Frete Subsidiado]
			        ),
			        NOT ISBLANK([@r])
			    )
			VAR _kMin = MINX(_base, [@k])
			VAR _kMax = MAXX(_base, [@k])
			VAR _n = _kMax - _kMin + 1
			VAR _rMax = MAXX(_base, [@r]) * 1.1
			VAR _mLo = FLOOR(MINX(_base, [@m]) * 100 - 3, 2) / 100
			VAR _mHi = CEILING(MAXX(_base, [@m]) * 100 + 2, 2) / 100
			VAR _geo =
			    ADDCOLUMNS(
			        _base,
			        "@i", [@k] - _kMin,
			        "@xp", ([@k] - _kMin + 0.5) / _n * 100,
			        "@bh", DIVIDE([@r], _rMax) * 1000,
			        "@lp", (1 - DIVIDE([@m] - _mLo, _mHi - _mLo)) * 100
			    )
			VAR _bw = 1000 / _n * 0.58
			VAR _kFG = 2024 * 12 + 3
			VAR _bars =
			    CONCATENATEX(
			        _geo,
			        "<rect fill='url(#" & IF([@k] >= _kFG, "gb", "ga") & ")' x='" & FORMAT([@xp] * 10 - _bw / 2, "0.0", "en-US") & "' y='" & FORMAT(1000 - [@bh], "0.0", "en-US")
			            & "' width='" & FORMAT(_bw, "0.0", "en-US") & "' height='" & FORMAT([@bh], "0.0", "en-US") & "'/>",
			        "", [@k], ASC
			    )
			VAR _pts = CONCATENATEX(_geo, FORMAT([@xp] * 10, "0.0", "en-US") & "," & FORMAT([@lp] * 10, "0.0", "en-US"), " ", [@k], ASC)
			VAR _grid =
			    "<line x1='0' x2='1000' y1='0' y2='0' class='gd' vector-effect='non-scaling-stroke'/>"
			    & "<line x1='0' x2='1000' y1='500' y2='500' class='gd' vector-effect='non-scaling-stroke'/>"
			    & "<line x1='0' x2='1000' y1='1000' y2='1000' class='gd' vector-effect='non-scaling-stroke'/>"
			VAR _svg =
			    "<svg class='sv' viewBox='0 0 1000 1000' preserveAspectRatio='none'>"
			    & "<defs><linearGradient id='ga' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#f4f1ec' stop-opacity='.22'/><stop offset='1' stop-color='#f4f1ec' stop-opacity='.06'/></linearGradient>"
			    & "<linearGradient id='gb' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='#e0a476'/><stop offset='1' stop-color='#e0a476' stop-opacity='.25'/></linearGradient></defs>"
			    & _grid & _bars
			    & "<polyline class='ln' points='" & _pts & "' vector-effect='non-scaling-stroke'/>"
			    & "</svg>"
			VAR _eixos =
			    "<span class='ya' style='top:0%'>" & FORMAT(_rMax / 1000000, "0.0", "pt-BR") & " Mi</span>"
			    & "<span class='ya' style='top:50%'>" & FORMAT(_rMax / 2000000, "0.0", "pt-BR") & " Mi</span>"
			    & "<span class='ya' style='top:100%'>0</span>"
			    & "<span class='yb' style='top:0%'>" & FORMAT(_mHi * 100, "0", "pt-BR") & "%</span>"
			    & "<span class='yb' style='top:50%'>" & FORMAT((_mHi + _mLo) * 50, "0", "pt-BR") & "%</span>"
			    & "<span class='yb' style='top:100%'>" & FORMAT(_mLo * 100, "0", "pt-BR") & "%</span>"
			    & CONCATENATEX(
			        FILTER(_geo, dCalendario[Mes_Num] = 1 || [@k] = _kMin),
			        "<span class='xa' style='left:" & FORMAT([@xp], "0.00", "en-US") & "%'>" & dCalendario[Mes_Ano] & "</span>",
			        "", [@k], ASC
			    )
			VAR _marco =
			    IF(
			        _kFG > _kMin && _kFG <= _kMax,
			        "<div class='mk' style='left:" & FORMAT((_kFG - _kMin) / _n * 100, "0.00", "en-US") & "%'><span>FRETE GRÁTIS ≥ R$ 199</span></div>"
			    )
			VAR _anot =
			    CONCATENATEX(
			        FILTER(_geo, dCalendario[Mes_Num] = 11),
			        "<div class='an' style='left:" & FORMAT([@xp], "0.00", "en-US") & "%;top:" & FORMAT([@lp], "0.00", "en-US") & "%'><i></i><span>Black Friday<b>" & FORMAT([@m] * 100, "0.0", "pt-BR") & "%</b></span></div>",
			        "", [@k], ASC
			    )
			VAR _ult = TOPN(1, _geo, [@k], DESC)
			VAR _fim =
			    "<div class='en' style='left:" & FORMAT(MAXX(_ult, [@xp]), "0.00", "en-US") & "%;top:" & FORMAT(MAXX(_ult, [@lp]), "0.00", "en-US") & "%'></div>"
			VAR _hover =
			    CONCATENATEX(
			        _geo,
			        "<div class='hc" & IF([@i] / _n > 0.72, " r", "") & "' style='left:" & FORMAT([@i] / _n * 100, "0.00", "en-US") & "%;width:" & FORMAT(100 / _n, "0.00", "en-US") & "%'>"
			            & "<i class='pt' style='top:" & FORMAT([@lp], "0.00", "en-US") & "%'></i>"
			            & "<div class='tip'><div class='t1'>" & UPPER(dCalendario[Mes_Ano]) & IF([@k] >= _kFG, "<span>frete grátis</span>", "") & "</div>"
			            & "<div class='tl'><span>Receita</span><b class='tb'>R$ " & FORMAT([@r] / 1000000, "0.00", "pt-BR") & " Mi</b></div>"
			            & "<div class='tl'><span>Margem</span><b class='tg'>" & FORMAT([@m] * 100, "0.0", "pt-BR") & "%</b></div>"
			            & "<div class='tl'><span>Frete subsidiado</span><b class='tr'>R$ " & FORMAT([@f] / 1000, "#,##0", "pt-BR") & " mil</b></div></div></div>",
			        "", [@k], ASC
			    )
			
			/* ---------- Textos ---------- */
			VAR _leva = (_frF - _frI) + (_cmF - _cmI)
			VAR _titulo = "Frete e marketplace levam <em>R$ " & FORMAT(_leva, _f1, "pt-BR") & "</em> de cada R$ 100."
			VAR _sub =
			    "Entre " & _anoIni & " e " & _anoFim & " a margem caiu de " & FORMAT(_mgI, _f1, "pt-BR") & "% para " & FORMAT(_mgF, _f1, "pt-BR")
			        & "%. O frete subsidiado subiu R$ " & FORMAT(_frF - _frI, _f1, "pt-BR") & " e a comissão do marketplace R$ " & FORMAT(_cmF - _cmI, _f1, "pt-BR") & " a cada R$ 100 vendidos."
			VAR _acao =
			    "<div class='at'>O QUE FAZER</div><ol>"
			    & "<li><b>Rever o frete grátis para " & _topCatNome & ".</b> A categoria concentra " & FORMAT(_topCatPct * 100, "0", "pt-BR") & "% dos R$ " & FORMAT(_fr1 / 1000, "#,##0", "pt-BR") & " mil de frete subsidiado em " & _anoFim & ".</li>"
			    & "<li><b>Repassar ou renegociar a comissão do " & _piorNome & ".</b> Margem de " & FORMAT(_piorM * 100, _f1, "pt-BR") & "% contra " & FORMAT(_outrosM * 100, _f1, "pt-BR") & "% nos demais canais.</li>"
			    & "</ol>"
			
			/* ---------- KPIs com verso (gira no hover: definição + dado de contexto) ---------- */
			VAR _ped1 = CALCULATE([Pedidos], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _tk1 = CALCULATE([Ticket Médio], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _pfg1 = CALCULATE([% Pedidos Frete Grátis], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
			VAR _devPior = MAXX(_pior, [@d])
			VAR _devOutros = DIVIDE(SUMX(FILTER(_canais, fVendas[Canal] <> _piorNome), [@r] * [@d]), SUMX(FILTER(_canais, fVendas[Canal] <> _piorNome), [@r]))
			VAR _ico = "<i class='fx'>↻</i>"
			VAR _card = "<div class='kc'><div class='fl'><div class='fr'>"
			VAR _kpis =
			    "<div class='kp'>"
			    & _card & _ico & "<div class='lb'>RECEITA " & _anoFim & "</div><div class='v'>R$ " & FORMAT(_rec1 / 1000000, "0.00", "pt-BR") & " Mi</div>" & _bRec & "</div>"
			    & "<div class='bk'><div class='lb'>RECEITA LÍQUIDA</div><p>Itens entregues, já sem descontos, devoluções e cancelamentos.</p><p><b>" & FORMAT(_ped1, "#,##0", "pt-BR") & " pedidos</b> · ticket médio <b>R$ " & FORMAT(_tk1, "#,##0", "pt-BR") & "</b></p></div></div></div>"
			    & _card & _ico & "<div class='lb'>MARGEM DE CONTRIBUIÇÃO</div><div class='v'>" & FORMAT(_mg1 * 100, "0.0", "pt-BR") & "%</div>" & _bMg & "</div>"
			    & "<div class='bk'><div class='lb'>MARGEM DE CONTRIBUIÇÃO</div><p>Receita − CMV − comissão do marketplace − frete subsidiado.</p><p>Cada 1 p.p. vale <b>R$ " & FORMAT(_rec1 / 100 / 1000, "#,##0", "pt-BR") & " mil</b> por ano.</p></div></div></div>"
			    & _card & _ico & "<div class='lb'>FRETE SUBSIDIADO</div><div class='v'>R$ " & FORMAT(_fr1 / 1000, "#,##0", "pt-BR") & " mil</div>" & _bFr & "</div>"
			    & "<div class='bk'><div class='lb'>FRETE SUBSIDIADO</div><p>Frete pago pela LUMA e não cobrado do cliente.</p><p><b>" & FORMAT(_pfg1 * 100, "0", "pt-BR") & "% dos pedidos</b> saem com frete grátis; " & _topCatNome & " gera <b>" & FORMAT(_topCatPct * 100, "0", "pt-BR") & "%</b> do custo.</p></div></div></div>"
			    & _card & _ico & "<div class='lb'>TAXA DE DEVOLUÇÃO</div><div class='v'>" & FORMAT(_dv1 * 100, "0.0", "pt-BR") & "%</div>" & _bDv & "</div>"
			    & "<div class='bk'><div class='lb'>TAXA DE DEVOLUÇÃO</div><p>Valor devolvido ÷ receita vendida.</p><p>" & _piorNome & " devolve <b>" & FORMAT(_devPior * 100, "0.0", "pt-BR") & "%</b> contra " & FORMAT(_devOutros * 100, "0.0", "pt-BR") & "% nos demais canais.</p></div></div></div>"
			    & "</div>"
			
			/* ---------- CSS ---------- */
			VAR _css = [_CSS Diagnostico]
			
			/* ---------- HTML ---------- */
			VAR _body =
			    "<div class='pg'>"
			    & "<div class='hero'>" & IF(_hero <> "", "<img src='" & _hero & "' alt=''>", "") & "<div class='ov'></div>"
			    & "<div class='htx'><div class='brand'>LUMA<span>DIAGNÓSTICO · " & _anoIni & "–" & _anoFim & "</span></div><h1>" & _titulo & "</h1><p>" & _sub & "</p></div></div>"
			    & _kpis
			    & "<div class='row' style='flex:1'>"
			    & "<div class='cd' style='flex:1.75'><div class='lb'>EVOLUÇÃO MENSAL</div><h2>A receita sobe. A margem desce a escada.</h2>"
			    & "<div class='lg'><span><i style='background:#e0a476'></i>Receita líquida</span><span><i style='background:#8fd1bd'></i>Margem %</span><span style='color:#f08a6c'><i style='background:#f08a6c;border-radius:50%'></i>Black Friday</span></div>"
			    & "<div class='ch'><div class='plot'>" & _svg & _eixos & _marco & _anot & _fim & _hover & "</div></div></div>"
			    & "<div class='cd wc' style='flex:1'><div class='lb'>PARA ONDE VAI CADA R$ 100</div>"
			    & "<div class='wf'><div><div class='wy'>" & _anoIni & "<b>R$ " & FORMAT(_mgI, _f1, "pt-BR") & "</b></div><div class='wg'>" & _wafI & "</div></div>"
			    & "<div><div class='wy'>" & _anoFim & "<b>R$ " & FORMAT(_mgF, _f1, "pt-BR") & "</b></div><div class='wg'>" & _wafF & "</div></div></div>"
			    & _linhaLeg & "</div>"
			    & "</div>"
			    & "<div class='row' style='flex:none;height:25%;padding-bottom:16px'>"
			    & "<div class='cd' style='flex:1.75'><div class='lb'>CANAIS · " & _anoFim & "</div><div class='chs'>" & _canaisHtml & "</div></div>"
			    & "<div class='cd ac' style='flex:1'>" & _acao & "</div>"
			    & "</div>"
			    & "</div>"
			
			RETURN _css & _body
		displayFolder: 9. HTML
		lineageTag: 9dae855e-8b56-4603-98b7-eb4627ddef15

	/// Data URI do quadro parado (JPEG) usado na faixa de abertura da página Diagnóstico.
	measure '_Img Hero Diag' =
			VAR _m = FILTER(ALL(dMidia), dMidia[Midia] = "hero_diag")
			VAR _tipo = MAXX(_m, dMidia[Tipo])
			RETURN
			    IF(
			        NOT ISEMPTY(_m),
			        "data:" & _tipo & ";base64," & CONCATENATEX(_m, dMidia[Parte], "", dMidia[Ordem], ASC),
			        ""
			    )
		displayFolder: 9. HTML
		lineageTag: 14a3a739-845f-4097-91d4-72d3179231a0

	/// Folha de estilo da página Diagnóstico (separada para facilitar ajustes visuais). Fonte: scripts/dax/CSS_Diagnostico.dax
	measure '_CSS Diagnostico' =
			"<style>
			*{box-sizing:border-box;margin:0;padding:0}
			.pg{--u:min(calc(100vw / 1280),calc(100vh / 720));width:100%;height:100vh;min-height:calc(var(--u)*620);background:#110c09;color:#f4f1ec;font-family:'Segoe UI',system-ui,sans-serif;display:flex;flex-direction:column;overflow:hidden}
			.hero{position:relative;height:30%;min-height:calc(var(--u)*180);flex:none;overflow:hidden}
			.hero img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;object-position:center 58%}
			.hero .ov{position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(90deg,rgba(17,12,9,.96) 0%,rgba(17,12,9,.82) 42%,rgba(17,12,9,.35) 100%),linear-gradient(180deg,rgba(17,12,9,0) 45%,#110c09 100%)}
			.htx{position:absolute;left:calc(var(--u)*32);top:calc(var(--u)*24);right:calc(var(--u)*32)}
			.brand{font-size:calc(var(--u)*11);letter-spacing:.32em;font-weight:700;opacity:.85}
			.brand span{opacity:.5;font-weight:400;margin-left:calc(var(--u)*10);letter-spacing:.24em}
			.htx h1{font-size:calc(var(--u)*32);font-weight:700;letter-spacing:-.01em;margin:calc(var(--u)*14) 0 calc(var(--u)*6);max-width:calc(var(--u)*760);line-height:1.15}
			.htx h1 em{font-style:normal;color:#f0b48a}
			.htx p{font-size:calc(var(--u)*13.5);opacity:.72;max-width:calc(var(--u)*960);font-weight:300;line-height:1.5}
			.kp{display:flex;gap:calc(var(--u)*12);padding:0 calc(var(--u)*28);margin-top:calc(var(--u)*-40);position:relative;z-index:2;flex:none}
			.kc{flex:1}
			.fl{position:relative;height:100%}
			.kc:hover .fl{animation:gira .5s ease-in-out}
			@keyframes gira{0%{transform:perspective(calc(var(--u)*900)) rotateY(0)}50%{transform:perspective(calc(var(--u)*900)) rotateY(90deg)}100%{transform:perspective(calc(var(--u)*900)) rotateY(0)}}
			.fr,.bk{background:rgba(32,24,19,.94);border:1px solid rgba(244,241,236,.1);border-radius:calc(var(--u)*12);padding:calc(var(--u)*11) calc(var(--u)*16);height:100%;transition:opacity .12s ease}
			.fr{position:relative}
			.bk{position:absolute;top:0;left:0;right:0;bottom:0;opacity:0;background:linear-gradient(135deg,rgba(224,164,118,.16),rgba(32,24,19,.96) 70%);border-color:rgba(224,164,118,.35);overflow:hidden}
			.kc:hover .fr{opacity:0}
			.kc:hover .bk{opacity:1}
			.kc:hover .fr,.kc:hover .bk{transition:opacity 0s linear .25s}
			.bk .lb{color:#f0b48a;opacity:.9}
			.bk p{font-size:calc(var(--u)*11.5);line-height:1.4;opacity:.85;margin-top:calc(var(--u)*4)}
			.bk p b{color:#f4f1ec;opacity:1}
			.fx{position:absolute;top:calc(var(--u)*9);right:calc(var(--u)*12);font-style:normal;font-size:calc(var(--u)*13);opacity:.3}
			.kc:hover .fx{opacity:.6}
			.lb{font-size:calc(var(--u)*10.5);letter-spacing:.22em;opacity:.55;font-weight:700}
			.kc .v{font-size:calc(var(--u)*26);font-weight:700;margin:calc(var(--u)*3) 0 calc(var(--u)*2)}
			.kc span{font-size:calc(var(--u)*12);font-weight:600}
			.up{color:#8fd1bd}.dn{color:#f08a6c}.nt{color:rgba(244,241,236,.45)}
			.row{display:flex;gap:calc(var(--u)*12);padding:calc(var(--u)*12) calc(var(--u)*28) 0;min-height:0}
			.cd{background:rgba(255,248,240,.035);border:1px solid rgba(244,241,236,.08);border-radius:calc(var(--u)*12);padding:calc(var(--u)*12) calc(var(--u)*16);display:flex;flex-direction:column;min-height:0;position:relative}
			.cd h2{font-size:calc(var(--u)*15.5);font-weight:600;margin:calc(var(--u)*3) 0 calc(var(--u)*4)}
			.lg{display:flex;gap:calc(var(--u)*16);font-size:calc(var(--u)*11.5);opacity:.7;margin-bottom:calc(var(--u)*4)}
			.lg i{display:inline-block;width:calc(var(--u)*10);height:calc(var(--u)*10);border-radius:calc(var(--u)*2);margin-right:calc(var(--u)*6);vertical-align:-1px}
			.ch{position:relative;flex:1;min-height:0}
			.plot{position:absolute;left:calc(var(--u)*40);right:calc(var(--u)*36);top:calc(var(--u)*12);bottom:calc(var(--u)*22)}
			.sv{position:absolute;top:0;left:0;width:100%;height:100%;overflow:visible}
			.gd{stroke:rgba(244,241,236,.08);stroke-width:1}
			.ln{fill:none;stroke:#8fd1bd;stroke-width:2.4;stroke-linejoin:round;filter:drop-shadow(0 0 calc(var(--u)*4) rgba(143,209,189,.45))}
			.ya,.yb{position:absolute;font-size:calc(var(--u)*11);color:rgba(244,241,236,.4);transform:translateY(-50%);white-space:nowrap}
			.ya{right:calc(100% + calc(var(--u)*8))}.yb{left:calc(100% + calc(var(--u)*8));color:rgba(143,209,189,.75)}
			.xa{position:absolute;top:calc(100% + calc(var(--u)*6));font-size:calc(var(--u)*11);color:rgba(244,241,236,.4);transform:translateX(-50%)}
			.mk{position:absolute;top:0;bottom:0;border-left:1px dashed rgba(240,138,108,.7)}
			.mk span{position:absolute;left:calc(var(--u)*7);top:calc(var(--u)*-2);font-size:calc(var(--u)*10);font-weight:700;letter-spacing:.12em;color:#f08a6c;white-space:nowrap}
			.an{position:absolute;pointer-events:none}
			.an i{position:absolute;width:calc(var(--u)*7);height:calc(var(--u)*7);border-radius:50%;background:#f08a6c;transform:translate(-50%,-50%);box-shadow:0 0 0 calc(var(--u)*3) rgba(240,138,108,.25)}
			.an span{position:absolute;right:calc(var(--u)*9);top:calc(var(--u)*-12);font-size:calc(var(--u)*10.5);color:#f08a6c;white-space:nowrap;text-align:right;line-height:1.15;background:rgba(17,12,9,.88);padding:calc(var(--u)*3) calc(var(--u)*6);border-radius:calc(var(--u)*5);border:1px solid rgba(240,138,108,.25)}
			.an b{display:block;font-size:calc(var(--u)*11)}
			.en{position:absolute;width:calc(var(--u)*9);height:calc(var(--u)*9);border-radius:50%;background:#8fd1bd;transform:translate(-50%,-50%);box-shadow:0 0 0 calc(var(--u)*4) rgba(143,209,189,.2)}
			.hc{position:absolute;top:0;bottom:0}
			.hc:hover{background:rgba(244,241,236,.05);z-index:5}
			.pt{position:absolute;left:50%;width:calc(var(--u)*9);height:calc(var(--u)*9);border-radius:50%;background:#110c09;border:calc(var(--u)*2) solid #8fd1bd;transform:translate(-50%,-50%);opacity:0}
			.tip{position:absolute;top:4%;left:calc(100% + calc(var(--u)*8));width:calc(var(--u)*190);background:rgba(24,18,14,.96);border:1px solid rgba(244,241,236,.14);border-radius:calc(var(--u)*10);padding:calc(var(--u)*10) calc(var(--u)*12);opacity:0;pointer-events:none;transition:opacity .15s;box-shadow:0 calc(var(--u)*10) calc(var(--u)*30) rgba(0,0,0,.45)}
			.hc.r .tip{left:auto;right:calc(100% + calc(var(--u)*8))}
			.hc:hover .tip,.hc:hover .pt{opacity:1}
			.t1{font-size:calc(var(--u)*13);font-weight:700;letter-spacing:.08em;margin-bottom:calc(var(--u)*6)}
			.t1 span{font-size:calc(var(--u)*10);font-weight:600;color:#f08a6c;margin-left:calc(var(--u)*8);letter-spacing:.1em}
			.tl{display:flex;justify-content:space-between;font-size:calc(var(--u)*12);padding:calc(var(--u)*2) 0}
			.tl span{opacity:.6}
			.tb{color:#f0b48a}.tg{color:#8fd1bd}.tr{color:#f08a6c}
			.wf{display:flex;gap:calc(var(--u)*18);margin:calc(var(--u)*2) 0 calc(var(--u)*4)}
			.wf > div{flex:1}
			.wy{font-size:calc(var(--u)*11);letter-spacing:.2em;opacity:.55;font-weight:700;margin-bottom:calc(var(--u)*4)}
			.wy b{font-size:calc(var(--u)*15);letter-spacing:0;opacity:1;color:#8fd1bd;margin-left:calc(var(--u)*6)}
			.wg{display:grid;grid-template-columns:repeat(10,1fr);gap:calc(var(--u)*2);max-width:calc(var(--u)*96)}
			.wg i{display:block;padding-top:100%;border-radius:calc(var(--u)*2)}
			.qm{background:#8fd1bd}.qf{background:#f08a6c}.qc{background:#d9a273}.qv{background:rgba(244,241,236,.13)}
			.lr{display:flex;align-items:center;gap:calc(var(--u)*8);font-size:calc(var(--u)*11.5);line-height:1.3;padding:calc(var(--u)*1.5) 0;border-top:1px solid rgba(244,241,236,.06)}
			.lr i{width:calc(var(--u)*9);height:calc(var(--u)*9);border-radius:calc(var(--u)*2);flex:none}
			.lr span{flex:1;opacity:.7}
			.lr b{font-weight:600}
			.lr em{font-style:normal;font-weight:700;width:calc(var(--u)*38);text-align:right}
			.chs{display:flex;gap:calc(var(--u)*10);flex:1;margin-top:calc(var(--u)*6)}
			.cc{flex:1;border:1px solid rgba(244,241,236,.08);border-radius:calc(var(--u)*10);padding:calc(var(--u)*9) calc(var(--u)*14);background:rgba(255,248,240,.02)}
			.cc.al{border-color:rgba(240,138,108,.45);background:rgba(240,138,108,.06)}
			.cn{display:flex;align-items:center;justify-content:space-between}
			.cn b{font-size:calc(var(--u)*15)}
			.tag{font-size:calc(var(--u)*9.5);font-weight:700;letter-spacing:.14em;color:#f08a6c;border:1px solid rgba(240,138,108,.5);border-radius:calc(var(--u)*4);padding:1px calc(var(--u)*5)}
			.cs{font-size:calc(var(--u)*12);opacity:.55;margin-top:calc(var(--u)*2)}
			.cbar{height:calc(var(--u)*4);background:rgba(244,241,236,.08);border-radius:calc(var(--u)*2);margin:calc(var(--u)*6) 0 calc(var(--u)*7)}
			.cbar i{display:block;height:calc(var(--u)*4);background:#e0a476;border-radius:calc(var(--u)*2)}
			.cv{display:flex;gap:calc(var(--u)*22)}
			.cv b{display:block;font-size:calc(var(--u)*19);line-height:1.15}
			.cv span{font-size:calc(var(--u)*11);opacity:.5}
			.cc.al .cv b{color:#f08a6c}
			.wc{overflow:hidden}
			.ac{border-left:calc(var(--u)*3) solid #f08a6c}
			.at{font-size:calc(var(--u)*10.5);letter-spacing:.22em;font-weight:700;color:#f08a6c;margin-bottom:calc(var(--u)*8)}
			.ac ol{padding-left:calc(var(--u)*20);margin:0;opacity:.9}
			.ac li{font-size:calc(var(--u)*14) !important;line-height:1.5 !important;margin:0 0 calc(var(--u)*10) !important;padding-left:calc(var(--u)*4)}
			.ac li b{font-size:inherit !important;color:#f4f1ec}
			.pg > .row:last-child{height:auto !important}
			.ac::after{content:'Ver categorias →';position:absolute;right:calc(var(--u)*16);top:calc(var(--u)*10);font-size:calc(var(--u)*12);font-weight:700;letter-spacing:.04em;color:#f0b48a;border-bottom:1px solid rgba(240,180,138,.45);padding-bottom:calc(var(--u)*1)}
			</style>"
		displayFolder: 9. HTML
