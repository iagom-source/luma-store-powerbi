		sourceColumn: Preco_Unit

	column Desconto_Pct
		dataType: double
		lineageTag: 2d515bfb-1412-49fd-8c41-7748210f1670
		sourceColumn: Desconto_Pct

	column Receita_Bruta
		dataType: double
		lineageTag: f5a169e3-1765-4509-a0db-490fb23e0958
		sourceColumn: Receita_Bruta

	column Desconto_Valor
		dataType: double
		lineageTag: 4bfdf872-6bd6-45aa-81f9-69002e3de26c
		sourceColumn: Desconto_Valor

	column Receita_Liquida
		dataType: double
		lineageTag: cd157df9-cf48-4342-92be-5650fae96133
		sourceColumn: Receita_Liquida

	column CMV
		dataType: double
		lineageTag: fb78bd94-1577-443d-89f4-499f318129a6
