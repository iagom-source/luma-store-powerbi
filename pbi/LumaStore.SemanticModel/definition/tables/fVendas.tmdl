	column Frete_Gratis
		dataType: string
		lineageTag: 6b4c6eb4-58b4-4111-82df-1013399997fc
		sourceColumn: Frete_Gratis

	column Status
		dataType: string
		lineageTag: dc3e9336-d38b-4b02-91ee-475792bdc2cd
