/// Itens de pedido 2023-2025 (grão: pedido x item)
table fVendas
	lineageTag: 9081cec5-32d1-4f1d-afca-c13fb02d10d9

	column ID_Pedido
		dataType: string
		lineageTag: b7e38b84-c561-4b2a-aac3-46b735a789cd
		sourceColumn: ID_Pedido

	column Item
		dataType: int64
		lineageTag: 14539fac-52f6-46f7-9ccc-8a2d2e41186e
		sourceColumn: Item

	column Data_Pedido
		dataType: dateTime
		lineageTag: 2d203260-23be-4df2-a13d-0497e6eb3957
		sourceColumn: Data_Pedido

	column ID_Cliente
		dataType: string
		lineageTag: d98a31ba-49dd-496f-b109-1b3ade3276cd
		sourceColumn: ID_Cliente

	column ID_Produto
		dataType: string
		lineageTag: 463dc420-2804-4af6-b5fc-8173554324ce
		sourceColumn: ID_Produto

	column Canal
		dataType: string
		lineageTag: ec7486c8-6784-4449-b0eb-00b95860e156
