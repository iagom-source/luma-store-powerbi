/* Capa · fundo WebP animado embutido (dMidia) + manchete + 3 KPIs + botões de navegação.
   Os botões são só desenho: a navegação é feita por botões nativos transparentes por cima. */
VAR _anoIni = CALCULATE(MIN(dCalendario[Ano]), ALLSELECTED(dCalendario))
VAR _anoFim = CALCULATE(MAX(dCalendario[Ano]), ALLSELECTED(dCalendario))
VAR _recIni = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoIni)
VAR _recFim = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
VAR _mIni = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoIni)
VAR _mFim = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
VAR _cresc = DIVIDE(_recFim - _recIni, _recIni)
VAR _perdida = [Margem Perdida]
VAR _url = [_URL Fundo Capa]

VAR _fMi = FORMAT(_recFim / 1000000, "#,##0.00", "pt-BR")
VAR _fCresc = FORMAT(_cresc * 100, "+#,##0;-#,##0", "pt-BR")
VAR _fMFim = FORMAT(_mFim * 100, "#,##0.0", "pt-BR")
VAR _fMIni = FORMAT(_mIni * 100, "#,##0.0", "pt-BR")
VAR _fPerd = FORMAT(_perdida / 1000000, "#,##0.00", "pt-BR")
VAR _fR100Ini = FORMAT(_mIni * 100, "#,##0", "pt-BR")
VAR _fR100Fim = FORMAT(_mFim * 100, "#,##0", "pt-BR")

VAR _css = "<style>
*{box-sizing:border-box;margin:0;padding:0}
.cv{position:relative;width:100%;height:100vh;min-height:520px;overflow:hidden;font-family:'Segoe UI',system-ui,sans-serif;color:#f4f1ec;background:radial-gradient(120% 90% at 50% 0%,#3b2a1f 0%,#1a1411 55%,#0d0a08 100%)}
.cv .bg{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;opacity:.6}
.ov{position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(13,10,8,.30) 0%,rgba(13,10,8,.50) 50%,rgba(13,10,8,.94) 100%)}
.brand{position:absolute;top:6%;left:5%}
.brand b{font-size:20px;letter-spacing:.32em;font-weight:700}
.brand span{display:block;font-size:9px;letter-spacing:.3em;opacity:.6;margin-top:5px}
.hero{position:absolute;top:22%;left:0;right:0;text-align:center;padding:0 6%}
.eyebrow{font-size:11px;letter-spacing:.38em;text-transform:uppercase;opacity:.65}
.cv h1{font-size:clamp(34px,6vw,66px);font-weight:700;margin:16px 0 12px;letter-spacing:-.01em}
.sub{font-size:clamp(14px,1.6vw,19px);opacity:.88;font-weight:300}
.sub b{color:#f0b48a;font-weight:600}
.rule{width:260px;height:1px;background:rgba(244,241,236,.25);margin:24px auto 14px}
.meta{font-size:10px;letter-spacing:.3em;opacity:.55;text-transform:uppercase}
.kpis{position:absolute;bottom:17%;left:9%;right:9%;display:flex;border-top:1px solid rgba(244,241,236,.14);padding-top:26px}
.k{flex:1;text-align:center;border-left:1px solid rgba(244,241,236,.14)}
.k:first-child{border-left:0}
.k .v{font-size:clamp(24px,3.2vw,40px);font-weight:700}
.k .l{font-size:10px;letter-spacing:.25em;text-transform:uppercase;opacity:.72;margin-top:6px;font-weight:600}
.k .n{font-size:12px;opacity:.55;margin-top:6px}
.k.neg .v,.k.neg .l{color:#f08a6c}
.nav{position:absolute;bottom:5.5%;left:0;right:0;display:flex;justify-content:center;gap:clamp(10px,1.3vw,22px)}
.nb{min-width:clamp(190px,17vw,300px);text-align:center;border:1px solid rgba(244,241,236,.32);background:rgba(17,12,9,.5);border-radius:10px;padding:clamp(9px,.95vw,15px) clamp(16px,1.7vw,28px);font-size:clamp(12px,1.05vw,17px);font-weight:600}
.nb span{color:#f0b48a;margin-right:8px}
@keyframes up{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.a1,.a2,.a3,.a4,.a5,.a6{animation:up 1s ease both}
.a2{animation-delay:.25s}.a3{animation-delay:.5s}.a4{animation-delay:.8s}.a5{animation-delay:1.1s}.a6{animation-delay:1.4s}
</style>"

VAR _fundo = IF(_url <> "", "<img class='bg' src='" & _url & "' alt=''>", "")

VAR _body =
    "<div class='cv'>" & _fundo & "<div class='ov'></div>"
    & "<div class='brand a1'><b>LUMA</b><span>CASA &amp; DECORAÇÃO</span></div>"
    & "<div class='hero'>"
    & "<div class='eyebrow a1'>Diagnóstico de rentabilidade &nbsp;·&nbsp; E-commerce</div>"
    & "<h1 class='a2'>O custo do frete grátis</h1>"
    & "<div class='sub a3'>De cada R$ 100 vendidos, a margem caiu de <b>R$ " & _fR100Ini & "</b> para <b>R$ " & _fR100Fim & "</b>.</div>"
    & "<div class='rule a3'></div>"
    & "<div class='meta a3'>Base " & _anoIni & "–" & _anoFim & " &nbsp;·&nbsp; Frete grátis desde mar/2024</div>"
    & "</div>"
    & "<div class='kpis'>"
    & "<div class='k a4'><div class='v'>R$ " & _fMi & " Mi</div><div class='l'>Receita " & _anoFim & "</div><div class='n'>" & _fCresc & "% vs " & _anoIni & "</div></div>"
    & "<div class='k a4'><div class='v'>" & _fMFim & "%</div><div class='l'>Margem " & _anoFim & "</div><div class='n'>era " & _fMIni & "% em " & _anoIni & "</div></div>"
    & "<div class='k neg a5'><div class='v'>R$ " & _fPerd & " Mi</div><div class='l'>Margem que não entrou</div><div class='n'>vs margem de " & _anoIni & "</div></div>"
    & "</div>"
    & "<div class='nav a6'><div class='nb'>Para onde foi a margem</div><div class='nb'>Onde o frete pesa</div></div>"
    & "</div>"

RETURN _css & _body
