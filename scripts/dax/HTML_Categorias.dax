/* Página 3 · Categorias — quem perdeu margem e por quê.
   Barras com marcador: barra = margem do último ano, tracinho = margem do primeiro ano. */
VAR _anoIni = CALCULATE(MIN(dCalendario[Ano]), ALLSELECTED(dCalendario))
VAR _anoFim = CALCULATE(MAX(dCalendario[Ano]), ALLSELECTED(dCalendario))
VAR _hero = [_Img Hero Cat]
VAR _f1 = "0.0"

VAR _cat0 =
    ADDCOLUMNS(
        VALUES(dProduto[Categoria]),
        "@r1", CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim),
        "@m0", CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoIni),
        "@m1", CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim),
        "@f1", CALCULATE([Frete Subsidiado], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim),
        "@g1", CALCULATE([% Pedidos Frete Grátis], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim),
        "@d1", CALCULATE([Taxa de Devolução], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim),
        "@t1", CALCULATE([Ticket Médio], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
    )
VAR _cat =
    ADDCOLUMNS(
        FILTER(_cat0, NOT ISBLANK([@r1])),
        "@perd", [@r1] * ([@m0] - [@m1]),
        "@fp", DIVIDE([@f1], [@r1]) * 100,
        "@dpp", ([@m1] - [@m0]) * 100
    )
VAR _rTot = SUMX(_cat, [@r1])
VAR _pTot = SUMX(_cat, [@perd])
VAR _top = TOPN(1, _cat, [@perd], DESC)
VAR _topNome = MAXX(_top, dProduto[Categoria])
VAR _topShP = DIVIDE(MAXX(_top, [@perd]), _pTot)
VAR _topShR = DIVIDE(MAXX(_top, [@r1]), _rTot)
VAR _topDpp = MAXX(_top, [@dpp])
VAR _quedaMin = -MAXX(_cat, [@dpp])
VAR _quedaMax = -MINX(_cat, [@dpp])
VAR _maiorQueda = MAXX(TOPN(1, _cat, [@dpp], ASC), dProduto[Categoria])
VAR _fpHi = TOPN(1, _cat, [@fp], DESC)
VAR _fpHiNome = MAXX(_fpHi, dProduto[Categoria])
VAR _fpHiV = MAXX(_fpHi, [@fp])
VAR _fpTopV = MAXX(_top, [@fp])
VAR _esc = MAXX(_cat, MAX([@m0], [@m1])) * 1.12
VAR _fpEsc = MAXX(_cat, [@fp]) * 1.1

/* ---------- Barras com marcador (ordem: margem perdida em R$) ---------- */
VAR _rank = ADDCOLUMNS(_cat, "@pos", RANKX(_cat, [@perd], , DESC))
VAR _barras =
    CONCATENATEX(
        _rank,
        "<div class='br" & IF(dProduto[Categoria] = _topNome, " hi", "") & IF([@pos] <= 3, " dw", "") & "'>"
            & "<div class='bn'><b>" & dProduto[Categoria] & "</b><span>" & FORMAT(DIVIDE([@r1], _rTot) * 100, "0", "pt-BR") & "% da receita</span></div>"
            & "<div class='bt'><i class='bb' style='width:" & FORMAT(DIVIDE([@m1], _esc) * 100, "0.0", "en-US") & "%'></i>"
            & "<i class='bm' style='left:" & FORMAT(DIVIDE([@m0], _esc) * 100, "0.0", "en-US") & "%'></i></div>"
            & "<div class='bv'><b>" & FORMAT([@m1] * 100, _f1, "pt-BR") & "%</b><span class='" & IF([@dpp] < 0, "dn", "up") & "'>" & FORMAT([@dpp], "+0.0;−0.0", "pt-BR") & " p.p.</span></div>"
            & "<div class='bp'><b>R$ " & FORMAT([@perd] / 1000, "#,##0", "pt-BR") & " mil</b><span>margem perdida</span></div>"
            & "<div class='tip'><div class='t1'>" & UPPER(dProduto[Categoria]) & " · " & _anoFim & "</div>"
            & "<div class='tl'><span>Receita</span><b>R$ " & FORMAT([@r1] / 1000000, "0.00", "pt-BR") & " Mi</b></div>"
            & "<div class='tl'><span>Ticket médio</span><b>R$ " & FORMAT([@t1], "#,##0", "pt-BR") & "</b></div>"
            & "<div class='tl'><span>Margem " & _anoIni & " → " & _anoFim & "</span><b>" & FORMAT([@m0] * 100, _f1, "pt-BR") & "% → " & FORMAT([@m1] * 100, _f1, "pt-BR") & "%</b></div>"
            & "<div class='tl'><span>Pedidos com frete grátis</span><b>" & FORMAT([@g1] * 100, "0", "pt-BR") & "%</b></div>"
            & "<div class='tl'><span>Devolução</span><b>" & FORMAT([@d1] * 100, _f1, "pt-BR") & "%</b></div></div>"
            & "</div>",
        "",
        [@perd], DESC
    )

/* ---------- Frete subsidiado a cada R$ 100 ---------- */
VAR _frete =
    CONCATENATEX(
        _cat,
        "<div class='fq" & IF(dProduto[Categoria] = _fpHiNome, " hi", "") & "'>"
            & "<span class='fn'>" & dProduto[Categoria] & "</span>"
            & "<div class='ft'><i style='width:" & FORMAT(DIVIDE([@fp], _fpEsc) * 100, "0.0", "en-US") & "%'></i></div>"
            & "<b>R$ " & FORMAT([@fp], _f1, "pt-BR") & "</b>"
            & "<em>ticket R$ " & FORMAT([@t1], "#,##0", "pt-BR") & "</em></div>",
        "",
        [@fp], DESC
    )

/* ---------- Textos ---------- */
VAR _titulo = "<em>" & _topNome & "</em> responde por " & FORMAT(_topShP * 100, "0", "pt-BR") & "% da margem que não entrou."
VAR _sub =
    "Todas as categorias perderam entre " & FORMAT(_quedaMin, _f1, "pt-BR") & " e " & FORMAT(_quedaMax, _f1, "pt-BR") & " p.p. de margem desde " & _anoIni
        & ". " & _topNome & " pesa mais porque vende mais: " & FORMAT(_topShR * 100, "0", "pt-BR") & "% da receita de " & _anoFim & "."
VAR _nota =
    "<b>Itens baratos pagam o frete mais caro.</b> " & _fpHiNome & " gasta R$ " & FORMAT(_fpHiV, _f1, "pt-BR") & " de frete a cada R$ 100 vendidos; "
        & _topNome & ", R$ " & FORMAT(_fpTopV, _f1, "pt-BR") & ". O peso do frete cresce quando o ticket médio cai."

/* ---------- HTML ---------- */
VAR _body =
    "<div class='pg'>"
    & "<div class='hero'>" & IF(_hero <> "", "<img src='" & _hero & "' alt=''>", "") & "<div class='ov'></div>"
    & "<div class='htx'><div class='brand'>LUMA<span>CATEGORIAS · " & _anoIni & "–" & _anoFim & "</span></div><h1>" & _titulo & "</h1><p>" & _sub & "</p></div></div>"
    & "<div class='row' style='flex:1'>"
    & "<div class='cd' style='flex:1.6'><div class='lb'>MARGEM POR CATEGORIA</div><h2>Todo mundo caiu. " & _topNome & " pesa pelo tamanho.</h2>"
    & "<div class='lg'><span><i style='background:#8fd1bd'></i>Margem " & _anoFim & "</span><span><i class='mk2'></i>Margem " & _anoIni & "</span><span>ordenado pela margem perdida em R$</span></div>"
    & "<div class='brs'>" & _barras & "</div></div>"
    & "<div class='cd' style='flex:1'><div class='lb'>FRETE SUBSIDIADO A CADA R$ 100 · " & _anoFim & "</div><h2>Quem paga o frete grátis.</h2>"
    & "<div class='frs'>" & _frete & "</div><div class='nota'>" & _nota & "</div></div>"
    & "</div>"
    & "<div class='bd'>"
    & "<div class='bx'><h3><em>" & _topNome & "</em> concentra o valor. Os itens baratos, o problema.</h3><p>Rever o frete grátis só para " & _topNome & " recupera a maior fatia em reais; subir o mínimo protege as categorias de ticket baixo.</p></div>"
    & "<div class='bs'><span>MARGEM PERDIDA EM " & _anoFim & "</span><b>R$ " & FORMAT(_pTot / 1000000, "0.00", "pt-BR") & " Mi</b><em>vs margem de cada categoria em " & _anoIni & "</em></div>"
    & "<div class='bs'><span>FRETE MAIS CARO / R$ 100</span><b>" & _fpHiNome & " · R$ " & FORMAT(_fpHiV, _f1, "pt-BR") & "</b><em>" & _topNome & ": R$ " & FORMAT(_fpTopV, _f1, "pt-BR") & "</em></div>"
    & "<div class='btn'>← Voltar ao diagnóstico</div>"
    & "</div>"
    & "</div>"

RETURN [_CSS Categorias] & _body
