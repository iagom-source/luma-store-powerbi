VAR _anoIni = CALCULATE(MIN(dCalendario[Ano]), ALLSELECTED(dCalendario))
VAR _anoFim = CALCULATE(MAX(dCalendario[Ano]), ALLSELECTED(dCalendario))
VAR _anoAnt = _anoFim - 1

/* ---------- KPIs: último ano selecionado vs ano anterior ---------- */
VAR _rec1 = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
VAR _rec0 = CALCULATE([Receita Líquida], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
VAR _mg1 = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
VAR _mg0 = CALCULATE([Margem %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
VAR _fr1 = CALCULATE([Frete Subsidiado], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
VAR _fr0 = CALCULATE([Frete Subsidiado], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
VAR _dv1 = CALCULATE([Taxa de Devolução], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim)
VAR _dv0 = CALCULATE([Taxa de Devolução], REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoAnt)
VAR _temAnt = NOT ISBLANK(_rec0)

VAR _dRec = DIVIDE(_rec1 - _rec0, _rec0)
VAR _dMg = (_mg1 - _mg0) * 100
VAR _dFr = DIVIDE(_fr1 - _fr0, _fr0)
VAR _dDv = (_dv1 - _dv0) * 100
VAR _semBase = "<span class='nt'>sem ano anterior</span>"
VAR _bRec = IF(_temAnt, "<span class='" & IF(_dRec >= 0, "up", "dn") & "'>" & IF(_dRec >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dRec) * 100, "0.0", "pt-BR") & "% vs " & _anoAnt & "</span>", _semBase)
VAR _bMg = IF(_temAnt, "<span class='" & IF(_dMg >= 0, "up", "dn") & "'>" & IF(_dMg >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dMg), "0.0", "pt-BR") & " p.p. vs " & _anoAnt & "</span>", _semBase)
VAR _bFr = IF(_temAnt, "<span class='" & IF(_dFr <= 0, "up", "dn") & "'>" & IF(_dFr >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dFr) * 100, "0.0", "pt-BR") & "% vs " & _anoAnt & "</span>", _semBase)
VAR _bDv = IF(_temAnt, "<span class='" & IF(_dDv <= 0, "up", "dn") & "'>" & IF(_dDv >= 0, "▲ ", "▼ ") & FORMAT(ABS(_dDv), "0.0", "pt-BR") & " p.p. vs " & _anoAnt & "</span>", _semBase)

/* ---------- Composição de cada R$ 100 por ano ---------- */
VAR _anos =
    ADDCOLUMNS(
        CALCULATETABLE(VALUES(dCalendario[Ano]), ALLSELECTED(dCalendario)),
        "@r", [Receita Líquida],
        "@cmv", [CMV],
        "@com", [Comissão Marketplace],
        "@fr", [Frete Subsidiado],
        "@mc", [Margem de Contribuição]
    )
VAR _p100 =
    ADDCOLUMNS(
        _anos,
        "@pc", DIVIDE([@cmv], [@r]) * 100,
        "@pm", DIVIDE([@com], [@r]) * 100,
        "@pf", DIVIDE([@fr], [@r]) * 100,
        "@pg", DIVIDE([@mc], [@r]) * 100
    )
VAR _frIni = MAXX(FILTER(_p100, dCalendario[Ano] = _anoIni), [@pf])
VAR _frFim = MAXX(FILTER(_p100, dCalendario[Ano] = _anoFim), [@pf])
VAR _cmIni = MAXX(FILTER(_p100, dCalendario[Ano] = _anoIni), [@pm])
VAR _cmFim = MAXX(FILTER(_p100, dCalendario[Ano] = _anoFim), [@pm])
VAR _mgIniP = MAXX(FILTER(_p100, dCalendario[Ano] = _anoIni), [@pg])
VAR _mgFimP = MAXX(FILTER(_p100, dCalendario[Ano] = _anoFim), [@pg])
VAR _stack =
    CONCATENATEX(
        _p100,
        "<div class='yr'><span class='yl'>" & dCalendario[Ano] & "</span><div class='stk'>"
            & "<i class='s1' style='width:" & FORMAT([@pc], "0.00", "en-US") & "%'>CMV R$ " & FORMAT([@pc], "0", "pt-BR") & "</i>"
            & "<i class='s2' style='width:" & FORMAT([@pm], "0.00", "en-US") & "%'>" & IF([@pm] >= 4, FORMAT([@pm], "0.0", "pt-BR"), "") & "</i>"
            & "<i class='s3' style='width:" & FORMAT([@pf], "0.00", "en-US") & "%'>" & IF([@pf] >= 2.5, FORMAT([@pf], "0.0", "pt-BR"), "") & "</i>"
            & "<i class='s4' style='width:" & FORMAT(MAX([@pg], 0), "0.00", "en-US") & "%'>R$ " & FORMAT([@pg], "0.0", "pt-BR") & "</i>"
            & "</div></div>",
        "",
        dCalendario[Ano], ASC
    )

/* ---------- Canais no último ano ---------- */
VAR _canais =
    CALCULATETABLE(
        ADDCOLUMNS(VALUES(fVendas[Canal]), "@r", [Receita Líquida], "@m", [Margem %], "@d", [Taxa de Devolução]),
        REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim
    )
VAR _rTot = SUMX(_canais, [@r])
VAR _mMax = MAXX(_canais, [@m])
VAR _canaisHtml =
    CONCATENATEX(
        _canais,
        "<div class='cr'><div class='cn'><b>" & fVendas[Canal] & "</b><span>" & FORMAT(DIVIDE([@r], _rTot) * 100, "0", "pt-BR") & "% da receita</span>"
            & "<div class='cbar'><i style='width:" & FORMAT(DIVIDE([@r], _rTot) * 100, "0.0", "en-US") & "%'></i></div></div>"
            & "<div class='cm" & IF([@m] < _mMax - 0.05, " bad", "") & "'><b>" & FORMAT([@m] * 100, "0.0", "pt-BR") & "%</b><span>margem</span></div>"
            & "<div class='cm" & IF([@d] > 0.08, " bad", "") & "'><b>" & FORMAT([@d] * 100, "0.0", "pt-BR") & "%</b><span>devolução</span></div></div>",
        "",
        [@r], DESC
    )
VAR _pior = TOPN(1, _canais, [@m], ASC)
VAR _piorNome = MAXX(_pior, fVendas[Canal])
VAR _piorM = MAXX(_pior, [@m])
VAR _outrosM = DIVIDE(SUMX(FILTER(_canais, fVendas[Canal] <> _piorNome), [@r] * [@m]), SUMX(FILTER(_canais, fVendas[Canal] <> _piorNome), [@r]))

/* ---------- Categoria que mais pesa no frete subsidiado ---------- */
VAR _cats =
    CALCULATETABLE(
        ADDCOLUMNS(VALUES(dProduto[Categoria]), "@f", [Frete Subsidiado]),
        REMOVEFILTERS(dCalendario), dCalendario[Ano] = _anoFim
    )
VAR _topCat = TOPN(1, _cats, [@f], DESC)
VAR _topCatNome = MAXX(_topCat, dProduto[Categoria])
VAR _topCatPct = DIVIDE(MAXX(_topCat, [@f]), SUMX(_cats, [@f]))

/* ---------- Gráfico mensal (SVG): barras = receita, linha = margem % ---------- */
VAR _W = 780
VAR _L = 46
VAR _T = 12
VAR _PW = 690
VAR _PH = 196
VAR _base =
    FILTER(
        ADDCOLUMNS(
            SUMMARIZE(dCalendario, dCalendario[Ano], dCalendario[Mes_Num], dCalendario[Mes_Ano]),
            "@k", dCalendario[Ano] * 12 + dCalendario[Mes_Num],
            "@r", [Receita Líquida],
            "@m", [Margem %]
        ),
        NOT ISBLANK([@r])
    )
VAR _kMin = MINX(_base, [@k])
VAR _kMax = MAXX(_base, [@k])
VAR _n = _kMax - _kMin + 1
VAR _step = DIVIDE(_PW, _n)
VAR _bw = _step * 0.62
VAR _rMax = MAXX(_base, [@r]) * 1.08
VAR _mLo = FLOOR(MINX(_base, [@m]) * 100 - 2, 2) / 100
VAR _mHi = CEILING(MAXX(_base, [@m]) * 100 + 2, 2) / 100
VAR _geo =
    ADDCOLUMNS(
        _base,
        "@x", _L + ([@k] - _kMin + 0.5) * _step,
        "@bh", DIVIDE([@r], _rMax) * _PH,
        "@ly", _T + (1 - DIVIDE([@m] - _mLo, _mHi - _mLo)) * _PH
    )
VAR _yB = _T + _PH
VAR _bars =
    CONCATENATEX(
        _geo,
        "<rect class='bar" & IF([@k] >= 2024 * 12 + 3, " pos", "") & "' x='" & FORMAT([@x] - _bw / 2, "0.0", "en-US") & "' y='" & FORMAT(_yB - [@bh], "0.0", "en-US")
            & "' width='" & FORMAT(_bw, "0.0", "en-US") & "' height='" & FORMAT([@bh], "0.0", "en-US") & "' rx='1.5'/>",
        "", [@k], ASC
    )
VAR _line = "<polyline class='ln' points='" & CONCATENATEX(_geo, FORMAT([@x], "0.0", "en-US") & "," & FORMAT([@ly], "0.0", "en-US"), " ", [@k], ASC) & "'/>"
VAR _ult = TOPN(1, _geo, [@k], DESC)
VAR _ultX = MAXX(_ult, [@x])
VAR _ultY = MAXX(_ult, [@ly])
VAR _dot = "<circle class='dt' cx='" & FORMAT(_ultX, "0.0", "en-US") & "' cy='" & FORMAT(_ultY, "0.0", "en-US") & "' r='3.5'/>"
VAR _grid =
    CONCATENATEX(
        GENERATESERIES(0, 2, 1),
        VAR _v = _rMax * [Value] / 2
        VAR _y = _yB - _PH * [Value] / 2
        VAR _mv = _mLo + (_mHi - _mLo) * [Value] / 2
        RETURN
            "<line class='gd' x1='" & _L & "' x2='" & _L + _PW & "' y1='" & FORMAT(_y, "0.0", "en-US") & "' y2='" & FORMAT(_y, "0.0", "en-US") & "'/>"
            & "<text class='ax' x='" & _L - 6 & "' y='" & FORMAT(_y + 3, "0.0", "en-US") & "' text-anchor='end'>" & FORMAT(_v / 1000000, "0.0", "pt-BR") & " Mi</text>"
            & "<text class='ax mg' x='" & _L + _PW + 6 & "' y='" & FORMAT(_y + 3, "0.0", "en-US") & "'>" & FORMAT(_mv * 100, "0", "pt-BR") & "%</text>",
        ""
    )
VAR _xLab =
    CONCATENATEX(
        FILTER(_geo, dCalendario[Mes_Num] = 1 || [@k] = _kMin),
        "<text class='ax' x='" & FORMAT([@x], "0.0", "en-US") & "' y='" & _yB + 16 & "' text-anchor='middle'>" & dCalendario[Mes_Ano] & "</text>",
        "", [@k], ASC
    )
VAR _kFG = 2024 * 12 + 3
VAR _xFG = _L + (_kFG - _kMin) * _step
VAR _marco =
    IF(
        _kFG > _kMin && _kFG <= _kMax,
        "<line class='mk' x1='" & FORMAT(_xFG, "0.0", "en-US") & "' x2='" & FORMAT(_xFG, "0.0", "en-US") & "' y1='" & _T & "' y2='" & _yB & "'/>"
            & "<text class='mkt' x='" & FORMAT(_xFG + 6, "0.0", "en-US") & "' y='" & _T + 10 & "'>FRETE GRÁTIS ≥ R$ 199</text>"
    )
VAR _hover =
    CONCATENATEX(
        _geo,
        VAR _tx = IF([@x] > _W - 190, [@x] - 168, [@x] + 12)
        RETURN
            "<g class='h'><rect class='hb' x='" & FORMAT([@x] - _step / 2, "0.0", "en-US") & "' y='" & _T & "' width='" & FORMAT(_step, "0.0", "en-US") & "' height='" & _PH & "'/>"
            & "<g class='tt' transform='translate(" & FORMAT(_tx, "0", "en-US") & ",22)'><rect width='156' height='62' rx='7'/>"
            & "<text x='12' y='19' class='t1'>" & UPPER(dCalendario[Mes_Ano]) & "</text>"
            & "<text x='12' y='37'>Receita  <tspan class='tb'>R$ " & FORMAT([@r] / 1000000, "0.00", "pt-BR") & " Mi</tspan></text>"
            & "<text x='12' y='53'>Margem  <tspan class='tg'>" & FORMAT([@m] * 100, "0.0", "pt-BR") & "%</tspan></text></g></g>",
        "", [@k], ASC
    )
VAR _svg =
    "<svg viewBox='0 0 " & _W & " 236' width='100%' height='100%' preserveAspectRatio='none'>"
        & _grid & _bars & _marco & _line & _dot & _xLab & _hover & "</svg>"

/* ---------- Textos ---------- */
VAR _fmt1 = "0.0"
VAR _titulo =
    "Frete e marketplace levam R$ " & FORMAT((_frFim - _frIni) + (_cmFim - _cmIni), _fmt1, "pt-BR") & " de cada R$ 100."
VAR _sub =
    "Entre " & _anoIni & " e " & _anoFim & " a margem caiu de " & FORMAT(_mgIniP, _fmt1, "pt-BR") & "% para " & FORMAT(_mgFimP, _fmt1, "pt-BR")
        & "%: o frete subsidiado subiu " & FORMAT(_frFim - _frIni, _fmt1, "pt-BR") & " e a comissão do marketplace " & FORMAT(_cmFim - _cmIni, _fmt1, "pt-BR") & " a cada R$ 100 vendidos."
VAR _acao =
    "<b>Ação · rever a regra do frete grátis para " & _topCatNome & ".</b> A categoria concentra "
        & FORMAT(_topCatPct * 100, "0", "pt-BR") & "% do frete subsidiado em " & _anoFim & " (R$ " & FORMAT(_fr1 / 1000, "#,##0", "pt-BR") & " mil no total). "
        & "No " & _piorNome & ", a margem é " & FORMAT(_piorM * 100, _fmt1, "pt-BR") & "% contra " & FORMAT(_outrosM * 100, _fmt1, "pt-BR") & "% nos demais canais."

/* ---------- CSS ---------- */
VAR _css = "<style>
*{box-sizing:border-box;margin:0;padding:0}
.pg{width:100%;height:100vh;min-height:640px;background:#f6f2ec;color:#2a211b;font-family:'Segoe UI',system-ui,sans-serif;padding:20px 26px 18px;display:flex;flex-direction:column;gap:12px;overflow:hidden}
.hd .ey{font-size:10px;letter-spacing:.28em;color:#b8653a;font-weight:700}
.hd h1{font-size:25px;font-weight:700;margin:4px 0 3px;letter-spacing:-.01em}
.hd p{font-size:12px;color:#7d7064;max-width:860px}
.kp{display:flex;gap:12px}
.kc{flex:1;background:#fffdf9;border:1px solid #e9e1d6;border-radius:12px;padding:11px 14px}
.kc .l{font-size:9.5px;letter-spacing:.18em;color:#8a7d70;font-weight:700}
.kc .v{font-size:23px;font-weight:700;margin:3px 0 2px}
.kc span{font-size:11px;font-weight:600}
.up{color:#2f7d5b}.dn{color:#c2502f}.nt{color:#a3978a}
.row{display:flex;gap:12px;min-height:0}
.r1{flex:1.55}.r2{flex:1}
.cd{background:#fffdf9;border:1px solid #e9e1d6;border-radius:12px;padding:12px 16px;display:flex;flex-direction:column;min-height:0}
.cd .ct{font-size:9.5px;letter-spacing:.18em;color:#8a7d70;font-weight:700}
.cd h2{font-size:14px;font-weight:700;margin:2px 0 6px}
.lg{display:flex;gap:14px;font-size:10.5px;color:#7d7064;margin-bottom:4px}
.lg i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.ch{flex:1;min-height:0}
.ch svg{display:block;overflow:visible}
.gd{stroke:#ece5db;stroke-width:1}
.ax{font-size:9.5px;fill:#a3978a}.ax.mg{fill:#2f6f62}
.bar{fill:#e2cdb6}.bar.pos{fill:#d6a985}
.ln{fill:none;stroke:#2f6f62;stroke-width:2.2;stroke-linejoin:round;pointer-events:none}
.dt{fill:#2f6f62;stroke:#fffdf9;stroke-width:2}
.mk{stroke:#c2502f;stroke-width:1.2;stroke-dasharray:4 3}
.mkt{font-size:9px;font-weight:700;fill:#c2502f;letter-spacing:.08em}
.hb{fill:#b8653a;opacity:0}
.h:hover .hb{opacity:.09}
.tt{opacity:0;pointer-events:none;transition:opacity .15s}
.h:hover .tt{opacity:1}
.tt rect{fill:#2a211b}
.tt text{font-size:11px;fill:#d9cfc4}
.tt .t1{font-weight:700;fill:#fff;letter-spacing:.06em}
.tb{font-weight:700;fill:#f0c9a6}.tg{font-weight:700;fill:#8fd1bd}
.cr{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #f0e9df}
.cr:last-child{border-bottom:0}
.cn{flex:1}
.cn b{font-size:13px}.cn span{font-size:10.5px;color:#8a7d70;margin-left:6px}
.cbar{height:6px;background:#f0e9df;border-radius:3px;margin-top:6px}
.cbar i{display:block;height:6px;background:#d6a985;border-radius:3px}
.cm{width:72px;text-align:right}
.cm b{display:block;font-size:15px}.cm span{font-size:9.5px;color:#8a7d70}
.cm.bad b{color:#c2502f}
.yr{display:flex;align-items:center;gap:10px;margin:5px 0}
.yl{width:34px;font-size:11px;font-weight:700;color:#7d7064}
.stk{flex:1;display:flex;height:24px;border-radius:5px;overflow:hidden}
.stk i{font-style:normal;font-size:10.5px;font-weight:600;line-height:24px;text-align:center;white-space:nowrap;overflow:hidden}
.s1{background:#e6dccf;color:#6f6256}.s2{background:#d9a273;color:#fff}.s3{background:#c2502f;color:#fff}.s4{background:#2f6f62;color:#fff}
.ac{background:#eaf3ef;border:1px solid #cfe3da;border-radius:12px;padding:14px 16px;font-size:12px;line-height:1.5;color:#2c4d44}
.ac b{display:block;color:#2f6f62;font-size:13px;margin-bottom:4px}
</style>"

/* ---------- HTML ---------- */
VAR _body =
    "<div class='pg'>"
    & "<div class='hd'><div class='ey'>DIAGNÓSTICO DE RENTABILIDADE · " & _anoIni & "–" & _anoFim & "</div><h1>" & _titulo & "</h1><p>" & _sub & "</p></div>"
    & "<div class='kp'>"
    & "<div class='kc'><div class='l'>RECEITA " & _anoFim & "</div><div class='v'>R$ " & FORMAT(_rec1 / 1000000, "0.00", "pt-BR") & " Mi</div>" & _bRec & "</div>"
    & "<div class='kc'><div class='l'>MARGEM DE CONTRIBUIÇÃO</div><div class='v'>" & FORMAT(_mg1 * 100, "0.0", "pt-BR") & "%</div>" & _bMg & "</div>"
    & "<div class='kc'><div class='l'>FRETE SUBSIDIADO</div><div class='v'>R$ " & FORMAT(_fr1 / 1000, "#,##0", "pt-BR") & " mil</div>" & _bFr & "</div>"
    & "<div class='kc'><div class='l'>TAXA DE DEVOLUÇÃO</div><div class='v'>" & FORMAT(_dv1 * 100, "0.0", "pt-BR") & "%</div>" & _bDv & "</div>"
    & "</div>"
    & "<div class='row' style='flex:1.25'>"
    & "<div class='cd r1'><div class='ct'>EVOLUÇÃO MENSAL</div><h2>A receita sobe, a margem desce a escada.</h2>"
    & "<div class='lg'><span><i style='background:#e2cdb6'></i>Receita líquida</span><span><i style='background:#2f6f62'></i>Margem %</span><span style='color:#c2502f'>┆ início do frete grátis</span></div>"
    & "<div class='ch'>" & _svg & "</div></div>"
    & "<div class='cd r2'><div class='ct'>CANAIS · " & _anoFim & "</div><h2>Marketplace vende, mas devolve e cobra.</h2>" & _canaisHtml & "</div>"
    & "</div>"
    & "<div class='row' style='flex:.62'>"
    & "<div class='cd r1'><div class='ct'>PARA ONDE VAI CADA R$ 100</div>"
    & "<div class='lg' style='margin-top:4px'><span><i style='background:#e6dccf'></i>CMV</span><span><i style='background:#d9a273'></i>Comissão marketplace</span><span><i style='background:#c2502f'></i>Frete subsidiado</span><span><i style='background:#2f6f62'></i>Margem</span></div>"
    & _stack & "</div>"
    & "<div class='r2 ac'>" & _acao & "</div>"
    & "</div>"
    & "</div>"

RETURN _css & _body
